# Names only — never commit real values. Local values come from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Server-only. Signs the 24-hour WhatsApp invoice links. At least 32 random characters
# (for example `openssl rand -base64 48`). Without it, sharing is refused; it never falls back to an unsigned link.
INVOICE_LINK_SECRET=
# Server-only. The public address the share link points at, no trailing slash (https://dakshanirmaantraders.in).
# In development the request's own host is used when this is empty; production refuses to share without it.
APP_ORIGIN=
